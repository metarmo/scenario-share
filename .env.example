# Browser-safe Supabase connection values. Use the publishable key, never a
# secret/service-role key, in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=https://hxjlmqdoqsnsmunkrtuk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only shared-link gate. Never prefix these with NEXT_PUBLIC_ and never
# commit the real password or signing secret. Use a random 32+ character secret.
SCENARIO_SHARE_GATE_PASSWORD=REPLACE_WITH_SHARED_PASSWORD
SCENARIO_SHARE_GATE_SIGNING_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET

# Used by `supabase start` for local Google OAuth. Keep real credentials in an
# ignored .env.local file or your secret manager.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
